<% content_for :title, t(".title") %>

<% content_for :breadcrumb do %>
  <div class="row">
    <div class="col">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to("Home", root_path) %></li>
          <li class="breadcrumb-item"><%= link_to("Apps", apps_path) %></li>
          <li class="breadcrumb-item active" aria-current="page"><%= t(".title") %></li>
        </ol>
      </nav>
    </div>
  </div>
<% end %>

<% content_for :action_bar do %>
  <%= link_to_copy_attributes_from_other_app %>

  <%= link_to(t(".cancel"), apps_path, class: "button") %>
<% end %>

<%= form_for app_decorate do |f| %>
  <%= render "fields", f: f, app: app %>

  <div class="">
    <%= f.submit t(".add_app") %>
  </div>
<% end %>
