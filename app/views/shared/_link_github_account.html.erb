<%# locals: (user:) %>
<% if Errbit::Config.github_authentication && user == current_user %>
  <span class="github">
    <% if user.github_account? %>
      <%= link_to t(".unlink", provider: Errbit::Config.github_site_title),
                  user_unlink_github_path(user),
                  method: :patch,
                  data: { confirm: t(".confirm") } %>
    <% else %>
      <%= link_to t(".link", provider: Errbit::Config.github_site_title),
                  user_github_omniauth_authorize_path,
                  method: :post %>
    <% end %>
  </span>
<% end %>
