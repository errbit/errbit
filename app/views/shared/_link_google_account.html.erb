<%# locals: (user:) %>
<% if Errbit::Config.google_authentication && user == current_user %>
  <span class="google">
    <% if user.google_account? %>
      <%= link_to t(".unlink", provider: Errbit::Config.google_site_title),
                  user_unlink_google_path(user),
                  method: :patch,
                  data: { confirm: t(".confirm") } %>
    <% else %>
      <%= link_to t(".link", provider: Errbit::Config.google_site_title),
                  user_google_oauth2_omniauth_authorize_path,
                  method: :post %>
    <% end %>
  </span>
<% end %>
