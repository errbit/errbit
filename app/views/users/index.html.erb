<div class="row">
  <div class="col">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><%= link_to("Home", root_path) %></li>
        <li class="breadcrumb-item active" aria-current="page"><%= t(".title") %></li>
      </ol>
    </nav>
  </div>
</div>

<% content_for :title, t(".title") %>

<% content_for :action_bar do %>
  <span>
    <%= link_to new_user_path do %>
      <i class="fa fa-plus-circle"></i>
      <%= t(".new") %>
    <% end %>
  </span>
<% end %>

<div class="row">
  <div class="col">

    <table id="users" class="table table-striped table-hover table-bordered">
      <thead>
        <tr>
          <% if Errbit::Config.use_gravatar %>
            <th>&nbsp;</th>
          <% end %>
          <th><%= t(".name") %></th>
          <% if Errbit::Config.user_has_username %>
            <th><%= t(".username") %></th>
          <% end %>
          <th><%= t(".email") %></th>
          <th><%= t(".admin") %></th>
        </tr>
      </thead>

      <tbody>
        <% @users.each do |user| %>
          <tr>
            <% if Errbit::Config.use_gravatar %>
              <td><%= gravatar_tag(user.email, s: 24) %></td>
            <% end %>
            <td><%= link_to user.name, user_path(user) %></td>
            <% if Errbit::Config.user_has_username %>
              <td><%= user.username %></td>
            <% end %>
            <td><%= user.email %></td>
            <td><%= user.admin? ? t(".admin_yes") : t(".admin_no") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

  </div>
</div>


<div class="row">
  <div class="col">
    <%= paginate @users %>
  </div>
</div>
