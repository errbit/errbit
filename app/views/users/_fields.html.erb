<%# locals: (f:, user:) %>

<%= errors_for user %>

<div class="row">
  <div class="col">
    <%= f.label :name, t(".name"), class: "form-label" %>
    <%= f.text_field :name, placeholder: t(".name_placeholder"), class: "form-control", required: true %>
  </div>
</div>

<% if Errbit::Config.user_has_username %>
  <div class="row">
    <div class="col">
      <%= f.label :username, t(".username") %>
      <%= f.text_field :username, autocomplete: "username" %>
    </div>
  </div>
<% end %>

<div class="row">
  <div class="col">
    <%= f.label :email, t(".email") %>
    <%= f.text_field :email, autocomplete: "email" %>
  </div>
</div>

<% if Errbit::Config.github_authentication %>
  <div class="row">
    <div class="col">
      <%= f.label :github_login, "#{Errbit::Config.github_site_title} login" %>
      <%= f.text_field :github_login %>
    </div>
  </div>
<% end %>

<div class="row">
  <div class="col">
    <%= f.label :per_page, t(".entries") %>
    <%= f.select :per_page, [10, 20, 30, 50, 75, 100] %>
  </div>
</div>

<div class="row">
  <div class="col">
    <%= f.label :time_zone, t(".time_zone") %>
    <%= f.time_zone_select :time_zone, ActiveSupport::TimeZone.all %>
  </div>
</div>

<div class="row">
  <div class="col">
    <%= f.label :password, t(".password") %>
    <%= f.password_field :password, autocomplete: "new-password" %>
  </div>
</div>

<div class="row">
  <div class="col">
    <%= f.label :password_confirmation, t(".password_confirmation") %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>
</div>

<% if current_user.admin? %>
  <div class="row">
    <div class="col">
      <div class="form-check">
        <%= f.check_box :admin %>
        <%= f.label :admin, t(".admin") %>
      </div>
    </div>
  </div>
<% end %>
