<!doctype html>
<html lang="en" data-bs-theme="light">
  <head>
    <title>
      <%= t(".title") %>
      &mdash;
      <%= yield(:page_title).present? ? yield(:page_title) : yield(:title) %>
    </title>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=0">

    <%= favicon_link_tag %>
    <%= csrf_meta_tag %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :application, integrity: true %>
    <%= javascript_include_tag :app %>
    <%= javascript_importmap_tags %>

    <%= yield :head %>
  </head>

  <body>
    <div>
      <div>
        <%#= link_to t(".errbit"), root_path %>
        <%#= render "shared/navigation" if current_user %>
        <%#= render "shared/session" %>
      </div>
    </div>

    <% if (breadcrumb = yield(:breadcrumb)).present? %>
      <div class="container">
        <%= breadcrumb %>
      </div>
    <% end %>

    <div>
      <div>
        <%= yield :title_avatar %>
        <h1><%#= yield :title %></h1>

        <span><%= yield :meta %></span>

        <% if (action_bar = yield(:action_bar)).present? %>
          <div>
            <%#= action_bar %>
          </div>
        <% end %>
      </div>

      <div class="container">
        <%#= render "shared/flash_messages" %>

        <%= yield %>
      </div>

      <% if content_for?(:comments) %>
        <div>
          <%#= yield :comments %>
        </div>
      <% end %>
    </div>

    <div class="container">
      <div class="w-100">&nbsp;</div>

      <hr class="text-dark">

      <div class="row text-center">
        <div class="col text-muted">
          <%= t(".powered_html", link: link_to(t(".errbit"), "https://github.com/errbit/errbit", target: "_blank")) %>

          <br>

          <%= Errbit::Version %>
        </div>
      </div>
    </div>

    <%= yield :scripts %>
  </body>
</html>
