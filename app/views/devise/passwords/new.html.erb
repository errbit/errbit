<% content_for :title, t(".forgot_your_password") %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= errors_for resource %>

  <div class="required">
    <%= f.label :email %>

    <%= f.text_field :email, value: params[:email] %>
  </div>

  <div class="buttons">
    <%= f.submit t(".send_me_reset_password_instructions") %>
  </div>
<% end %>
