<% content_for :title, "Sign in" %>

<% if Errbit::Config.github_authentication || Errbit::Config.google_authentication %>
  <% content_for :action_bar do %>
    <div>
      <% if Errbit::Config.github_authentication %>
        <span>
          <%= link_to "Sign in with #{Errbit::Config.github_site_title}", user_github_omniauth_authorize_path, method: :post %>
        </span>
      <% end %>

      <% if Errbit::Config.google_authentication %>
        <span>
          <%= link_to "Sign in with #{Errbit::Config.google_site_title}", user_google_oauth2_omniauth_authorize_path, method: :post %>
        </span>
      <% end %>
    </div>
  <% end %>
<% end %>

<% auth_key = Devise.authentication_keys.first %>

<% auth_text = Errbit::Config.user_has_username ? "Username" : "Email address" %>

<% auth_key_autocomplete = Errbit::Config.user_has_username ? "username" : "email" %>

<div class="row justify-content-center">
  <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4 text-center m-auto">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-3">
        <%= f.label auth_key, auth_text, class: "form-label" %>

        <%= f.email_field auth_key, class: "form-control", placeholder: auth_text, required: true, autofocus: true, autocomplete: auth_key_autocomplete, tabindex: 1 %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Password", class: "form-label" %>

        <%= f.password_field :password,
                             class: "form-control",
                             placeholder: "Password",
                             required: true,
                             autocomplete: "current-password",
                             tabindex: 2 %>
      </div>
    <% end %>
  </div>
</div>


<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div>
    <%= link_to "forgot it?", new_password_path(resource_name), id: "forgot_password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div>
      <%= f.check_box :remember_me, tabindex: 3 %>

      <%= f.label :remember_me %>
    </div>
  <% end %>

  <div>
    <button type="submit">
      <%= t(".sign_in") %>
    </button>
  </div>
<% end %>
